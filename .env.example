# скопируйте этот файл в .env

# адрес сайта (нужен для ссылок в боте)
PUBLIC_URL=http://localhost:8000

TZ_NAME=Asia/Yakutsk

# сколько шагов в день
STAMINA_PER_DAY=4

# токен бота с business.max.ru
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru

# ночью бот молчит, план на день присылает в DIGEST_HOUR
QUIET_FROM=21
QUIET_TO=8
DIGEST_HOUR=15
